{
  "name": "aurora-pms",
  "version": "0.1.0",
  "private": true,
  "description": "Property Management System para hotel boutique con actualizaciones en tiempo real (Node.js + Express + EJS + Socket.IO + PostgreSQL).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "dev": "node --watch src/main.js",
    "start": "node src/main.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:setup": "node scripts/migrate.js && node scripts/seed.js",
    "db:reset": "node scripts/migrate.js --reset && node scripts/seed.js",
    "perf:guests": "node scripts/perf-guests.js",
    "test": "node --test --test-concurrency=1 --test-reporter=spec \"test/**/*.test.js\"",
    "test:unit": "node --test --test-reporter=spec \"test/unit/**/*.test.js\"",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"src/**\" --test-reporter=spec \"test/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/big-shoulders": "^5.3.0",
    "compression": "^1.8.2",
    "connect-pg-simple": "^10.0.0",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1"
  }
}
