<section class="login" aria-labelledby="forgot-title">
  <div class="login__brand">
    <svg class="login__mark" aria-hidden="true"><use href="/img/icons.svg#key"></use></svg>
    <p class="login__name"><%= appName %></p>
  </div>

  <% if (sent) { %>
  <div class="login__heading">
    <h1 class="login__title" id="forgot-title">Revisa tu correo</h1>
    <p class="flash flash--success" role="status"><%= message %></p>
    <p class="login__lead">El enlace caduca en <%= ttlMinutes %> minutos y solo funciona una vez. Si pides otro, el anterior deja de servir.</p>
  </div>
  <% if (showMailOutbox) { %>
  <p class="dev-note">Entorno de desarrollo: los correos son simulados. Ábrelos en la
    <a class="text-link" href="/dev/correos">bandeja de pruebas</a>.</p>
  <% } %>
  <p class="login__alt"><a class="text-link" href="/login">Volver a iniciar sesión</a></p>
  <% } else { %>
  <div class="login__heading">
    <h1 class="login__title" id="forgot-title">¿Olvidaste tu clave?</h1>
    <p class="login__lead">Escribe el correo de tu cuenta y te enviaremos un enlace para elegir una nueva.</p>
  </div>

  <%- include('../partials/form-alert', { errors }) %>

  <form class="form" method="post" action="/forgot-password" data-validate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%- include('../partials/field', {
      name: 'email', label: 'Correo', type: 'email', value: values.email, error: errors.email,
      attrs: { required: true, maxlength: 254, autocomplete: 'email', autofocus: true,
               pattern: '[^@\\s]+@[^@\\s]+\\.[^@\\s]+',
               'data-msg-pattern': 'Escribe un correo válido, por ejemplo ana@hotel.com.' }
    }) %>
    <button class="button button--primary button--block" type="submit">Enviarme el enlace</button>
  </form>

  <p class="login__alt"><a class="text-link" href="/login">Volver a iniciar sesión</a></p>
  <% } %>
</section>
