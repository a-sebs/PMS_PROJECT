<section class="login" aria-labelledby="reset-title">
  <div class="login__brand">
    <svg class="login__mark" aria-hidden="true"><use href="/img/icons.svg#key"></use></svg>
    <p class="login__name"><%= appName %></p>
  </div>

  <% if (!valid) { %>
  <div class="login__heading">
    <h1 class="login__title" id="reset-title">Este enlace ya no sirve</h1>
    <p class="login__lead">Puede que haya caducado, que ya lo hayas usado o que hayas pedido uno más reciente.</p>
  </div>
  <a class="button button--primary button--block" href="/forgot-password">Pedir un enlace nuevo</a>
  <p class="login__alt"><a class="text-link" href="/login">Volver a iniciar sesión</a></p>
  <% } else { %>
  <div class="login__heading">
    <h1 class="login__title" id="reset-title">Elige una nueva clave</h1>
    <p class="login__lead"><% if (email) { %>Para la cuenta <strong><%= email %></strong>. <% } %>Al guardarla se cerrarán las sesiones abiertas en otros dispositivos.</p>
  </div>

  <%- include('../partials/form-alert', { errors }) %>

  <form class="form" method="post" action="/reset-password/<%= token %>" data-validate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <%# Ayuda a los gestores de contraseñas a asociar la clave nueva con la cuenta. %>
    <input type="hidden" name="username" value="<%= email %>" autocomplete="username">

    <%- include('../partials/field', {
      name: 'password', label: 'Nueva contraseña', type: 'password', error: errors.password,
      hint: `Al menos ${passwordRules.minLength} caracteres, con letras y números.`,
      attrs: { required: true, minlength: passwordRules.minLength, maxlength: passwordRules.maxLength,
               autocomplete: 'new-password', autofocus: true, 'data-validate-password': true }
    }) %>
    <%- include('../partials/field', {
      name: 'passwordConfirm', label: 'Repite la nueva contraseña', type: 'password', error: errors.passwordConfirm,
      attrs: { required: true, maxlength: passwordRules.maxLength, autocomplete: 'new-password',
               'data-validate-match': 'password', 'data-msg-required': 'Repite la contraseña.' }
    }) %>
    <button class="button button--primary button--block" type="submit">Guardar la nueva clave</button>
  </form>
  <% } %>
</section>
