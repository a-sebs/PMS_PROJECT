<section class="login" aria-labelledby="login-title">
  <div class="login__brand">
    <svg class="login__mark" aria-hidden="true"><use href="/img/icons.svg#key"></use></svg>
    <p class="login__name"><%= appName %></p>
  </div>

  <h1 class="login__title" id="login-title">Inicia sesión para empezar tu turno</h1>

  <% if (error) { %>
  <p class="flash flash--error" role="alert" id="login-error"><%= error %></p>
  <% } %>

  <form class="form" method="post" action="/login">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="field">
      <label class="field__label" for="email">Correo</label>
      <input class="field__input" id="email" name="email" type="email" autocomplete="username"
             required maxlength="254" value="<%= email %>" autofocus<%- error ? ' aria-describedby="login-error"' : '' %>>
    </div>

    <div class="field">
      <div class="field__row">
        <label class="field__label" for="password">Contraseña</label>
        <a class="text-link text-link--small" href="/forgot-password">¿Olvidaste tu clave?</a>
      </div>
      <input class="field__input" id="password" name="password" type="password"
             autocomplete="current-password" required maxlength="200">
    </div>

    <button class="button button--primary button--block" type="submit">Entrar</button>
  </form>

  <p class="login__alt">¿Trabajas en el hotel y aún no tienes cuenta? <a class="text-link" href="/signup">Crea tu cuenta</a></p>

  <% if (demoUsers.length > 0) { %>
  <details class="demo-users">
    <summary>Usuarios de demostración (solo en desarrollo)</summary>
    <ul class="demo-users__list">
      <% for (const user of demoUsers) { %>
      <li><code><%= user.email %></code> <span><%= user.role %></span></li>
      <% } %>
    </ul>
    <p class="demo-users__hint">La contraseña es la de <code>SEED_PASSWORD</code> en tu <code>.env</code> (por defecto <code>Aurora2026!</code>).</p>
  </details>
  <% } %>
</section>
