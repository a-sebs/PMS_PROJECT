NODE_ENV=development
DATABASE_URL=postgres://pms:pms@localhost:5432/pms_dev
# Las pruebas pueden borrar esta base; conserva el sufijo _test.
TEST_DATABASE_URL=postgres://pms:pms@localhost:5432/pms_test
# Genera el secreto local con openssl rand -hex 32.
SESSION_SECRET=

# Entrega de correos.
#   outbox → el correo queda en la bandeja de pruebas (/dev/correos). Es el modo por defecto y el
#            que usan las pruebas automatizadas, así que no necesita credenciales.
#   smtp   → el correo sale de verdad. Con este valor, las cuatro variables siguientes son
#            obligatorias y la aplicación no arranca si falta alguna.
MAIL_TRANSPORT=outbox
# MAIL_FROM=tu-cuenta@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=tu-cuenta@gmail.com
# SMTP_PASS=contraseña-de-aplicación-de-16-caracteres
